# Local make dev values — copy to .env and adjust as needed
ELASTICSEARCH_URL=http://localhost:9200

R2_ENDPOINT_URL=http://localhost:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=gen-fashion-images

# Firestore emulator (local) — leave blank to use production ADC at deployment
FIRESTORE_EMULATOR_HOST=localhost:8080
GOOGLE_CLOUD_PROJECT=gen-fashion-local

# Vertex AI (for --with-embeddings).  ADC is used by default; set this to a
# service-account JSON when running locally against the hackathon GCP project.
# Path is relative to scripts/seed_shared_closet/ (the credentials/ dir is gitignored).
# GOOGLE_APPLICATION_CREDENTIALS=../../credentials/vertex-ai-sa.json
GOOGLE_CLOUD_LOCATION=us-central1

# Seeding config
MAX_ITEMS_PER_CATEGORY=150
