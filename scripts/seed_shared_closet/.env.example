# Local make dev values — copy to .env and adjust as needed
ELASTICSEARCH_URL=http://localhost:9200

R2_ENDPOINT_URL=http://localhost:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=gen-fashion-images

# Firestore emulator (local) — leave blank to use production ADC at deployment
FIRESTORE_EMULATOR_HOST=localhost:8080
# Firestore data project (Firebase project) — must match the app/frontend
# emulator namespace so seeded shared_closets are visible. Falls back to
# GOOGLE_CLOUD_PROJECT when unset (e.g. production where they are equal).
FIREBASE_PROJECT_ID=gen-fashion-local

# Vertex AI (for --with-embeddings): the project that has aiplatform access.
# Locally this differs from FIREBASE_PROJECT_ID; in prod they are the same.
GOOGLE_CLOUD_PROJECT=gen-fashion-local
# Vertex AI service-account JSON. Path is relative to scripts/seed_shared_closet/.
# GOOGLE_APPLICATION_CREDENTIALS=../../credentials/vertex-ai-sa.json
GOOGLE_CLOUD_LOCATION=us-central1

# Seeding config
MAX_ITEMS_PER_CATEGORY=150
