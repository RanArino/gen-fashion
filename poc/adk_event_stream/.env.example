# GCP project used for Gemini API calls via ADK
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Use Vertex AI backend (ADK 2.x defaults to Gemini API / API key mode otherwise)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_LOCATION=us-central1

# ADK agent model.
# gemini-2.0-flash works with GOOGLE_GENAI_API_KEY (direct Gemini API).
# gemini-2.5-flash works with GOOGLE_GENAI_USE_VERTEXAI=True (Vertex AI backend).
AGENT_MODEL=gemini-2.5-flash
