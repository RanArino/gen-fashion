# GCP project with Vertex AI API enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region. us-central1 works for gemini-2.5-flash-image.
# NOTE: gemini-3-pro-image-preview is only servable from GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_LOCATION=us-central1

# Nano Banana = Gemini image model.
#   gemini-2.5-flash-image     (fast, us-central1)         ← default
#   gemini-3-pro-image-preview (best quality, location=global)
NANOBANANA_MODEL=gemini-2.5-flash-image

# Alternatively, use the Gemini Developer API instead of Vertex AI:
# GOOGLE_GENAI_API_KEY=your-api-key
