# =============================================================================
# gen-fashion ローカル開発用 環境変数テンプレート
#   使い方:  cp .env.example .env   （.env はリポジトリルートに置く）
#   現在のフェーズ: M2 = クローゼット管理バックエンド (Web)
#
#   既定値は `make dev` (docker-compose) のローカル構成に一致。
#   注: docker-compose が root .env から参照する変数:
#       GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION, GOOGLE_APPLICATION_CREDENTIALS_HOST,
#       INTERNAL_TASK_SECRET（それ以外は compose 側でハードコード or デフォルト値）
#       （fastapi をコンテナ外で直接起動する場合は config.py が .env 全体を読む）
# =============================================================================

# -----------------------------------------------------------------------------
# [1] このフェーズで必須: あなたが値を入れるもの
# -----------------------------------------------------------------------------
# Vertex AI を使うため Gemini API キーは不要。
# credentials/vertex-ai-sa.json を置き、[3] の GOOGLE_APPLICATION_CREDENTIALS_HOST を確認すること。
# （Gemini Developer API キーで試したい場合は下記をコメント解除し GOOGLE_GENAI_USE_VERTEXAI=false に変更）
# GEMINI_API_KEY=your-api-key-here
# GOOGLE_GENAI_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# [2] ローカル依存サービス接続（make dev の既定。通常そのままでよい）
# -----------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=firestore-emulator:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth-emulator:9099
ELASTICSEARCH_URL=http://elasticsearch:9200

# ローカル R2 代替 = MinIO。
#   R2_ENDPOINT_URL        : コンテナ内からの接続先
#   R2_PUBLIC_ENDPOINT_URL : 署名付きURLに埋め込むホスト（ブラウザ/curl から到達可能に）
R2_ENDPOINT_URL=http://minio:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=gen-fashion-images

# -----------------------------------------------------------------------------
# [3] アプリ設定（既定値あり。必要時のみ変更）
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=gen-fashion-local
MAX_CLOSET_IMAGES_PER_USER=20
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_HOST=./credentials/vertex-ai-sa.json
IMAGE_ANALYSIS_MODEL=gemini-2.5-flash
TASK_QUEUE_MODE=local
ADK_INTERNAL_BASE_URL=http://fastapi-service:8000
# /internal/* ワーカールートを守る共有シークレット（タスク投入元が送り、サーバが検証）。
#   未設定だと内部ルートはロック(503)される（フェイルクローズ）。ローカルは既定値でよい。
#   本番は OIDC + Cloud Run internal ingress に置換（[4] / M2 ExecPlan の BLOCKING ゲート参照）。
INTERNAL_TASK_SECRET=local-dev-internal-secret
# 以下は config.py の既定値。変更時のみコメント解除:
# EMBEDDING_MODEL=gemini-embedding-2       # M5 ベクトル検索前に実呼び出しの検証が必要
# EMBEDDING_DIMENSIONS=768
# CLOTHING_ITEMS_INDEX=clothing_items
# FIRESTORE_DATABASE_ID=(default)

# -----------------------------------------------------------------------------
# [3.5] Flutter Web クライアント (M2 フロントエンド)
#   `make web` は以下の dart-define を渡して `flutter run -d chrome --web-port 8088`
#   を起動する。値を変える場合は Makefile の web ターゲットを編集する。
#     API_BASE_URL=http://localhost:8000
#     USE_EMULATORS=true
#     FIREBASE_PROJECT_ID=gen-fashion-local
#     FIREBASE_API_KEY=demo-local-api-key
#     FIREBASE_APP_ID=1:000000000000:web:0000000000000000
#     FIREBASE_MESSAGING_SENDER_ID=000000000000
#     FIREBASE_AUTH_DOMAIN=gen-fashion-local.firebaseapp.com
#     FIREBASE_STORAGE_BUCKET=gen-fashion-local.appspot.com
#     AUTH_EMULATOR_HOST=localhost / AUTH_EMULATOR_PORT=9099
#     FIRESTORE_EMULATOR_HOST=localhost / FIRESTORE_EMULATOR_PORT=8080
#   Generated FlutterFire config files such as flutter-web-app/lib/firebase_options.dart
#   are intentionally ignored; pass real production Firebase values via dart-define.
#   MinIO は MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:8088 で署名付き PUT を
#   許可済み（docker-compose.yml）。Security Rules テスト（M2-12）は
#   `firebase emulators:exec --only firestore` 経由で `firebase/` から実行する
#   （firebase-tools + JRE 11+ 必要）。
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# [4] このフェーズでは不要 — 本番デプロイ時のみ設定
#     （ローカルは MinIO / エミュレータ / Local キューで完結するため未使用）
# -----------------------------------------------------------------------------
# 本番 Cloudflare R2:
# R2_ACCOUNT_ID=
# 本番 Elasticsearch 認証（ローカルは認証なし）:
# ELASTICSEARCH_API_KEY=
# 本番 Cloud Tasks（TASK_QUEUE_MODE=cloud_tasks のとき）:
# CLOUD_TASKS_QUEUE_EMBED=
# CLOUD_TASKS_LOCATION=asia-northeast1
# （ADC 認証 / Vertex AI サービスアカウントは [3] の GOOGLE_APPLICATION_CREDENTIALS_HOST を参照）

# -----------------------------------------------------------------------------
# [5] 後続マイルストーンで使用（現フェーズ M2 では未使用）
# -----------------------------------------------------------------------------
# M4 ADK エージェント（adk-agent-service が使用 / adk-agent-service/.env.example も参照）:
# AGENT_MODEL=gemini-2.0-flash
# M6 LINE / 楽天:
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# RAKUTEN_APP_ID=
# LIFF_ID=
# LINE_LOGIN_CHANNEL_ID=
