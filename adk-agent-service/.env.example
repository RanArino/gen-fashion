# =============================================================================
# adk-agent-service 環境変数テンプレート (M4, Python ADK — ADL-022)
#   cp .env.example .env して値を埋める。`adk web` / pydantic-settings が
#   サービスルートの .env を読む。ローカル一括起動は make dev を使用。
# =============================================================================

# Agent model (req §7.1/§12.2). Vertex AI では gemini-2.5-flash を使うこと
# (M1-4: このプロジェクトの Vertex に gemini-2.0-flash は無い)。
AGENT_MODEL=gemini-2.0-flash

# Gemini backend — どちらか一方:
#   1) 直接 API キー (ローカル開発のデフォルト)
GOOGLE_GENAI_API_KEY=
#   2) Vertex AI (ADC / サービスアカウント)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=gen-fashion-local
GOOGLE_CLOUD_LOCATION=us-central1

# Tool-side models (fastapi-service/app/config.py と同じ既定値)
IMAGE_ANALYSIS_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
IMAGE_GENERATION_MODEL=gemini-2.5-flash-image

# Elasticsearch (clothing_items index — M2-9/M3-2 と共有)
ELASTICSEARCH_URL=http://localhost:9200
CLOTHING_ITEMS_INDEX=clothing_items

# Firestore (sessions / agentEvents — M5)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE_ID=(default)
INTERNAL_TASK_SECRET=local-dev-internal-secret

# Rakuten Ichiba Item Search (MK-3) — 未設定なら search_rakuten は
# unavailable 扱い (閉じたクローゼット提案にフォールバック)。実キーは入れない。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# R2 / MinIO (M2 と同じバケット・認証情報)
R2_ENDPOINT_URL=http://localhost:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=gen-fashion-images
RAKUTEN_APPLICATION_URL=https://gen-fashion-app.web.app/
