# =============================================================================
# adk-agent-service 環境変数テンプレート
#   このサービスは M4（ADK エージェント）で実装・使用する。
#   現在のフェーズ M2（クローゼット管理バックエンド）では未使用 — 設定不要。
#   ローカル一括起動は make dev（リポジトリルートの docker-compose）を使用。
# =============================================================================
GOOGLE_CLOUD_PROJECT=gen-fashion-local
GOOGLE_CLOUD_LOCATION=us-central1
# standalone 起動時（docker-compose 外）: GOOGLE_APPLICATION_CREDENTIALS に実パスを指定する。
# make dev 経由の場合はルートの .env の GOOGLE_APPLICATION_CREDENTIALS_HOST が使われるためここは不要。
GOOGLE_APPLICATION_CREDENTIALS=../../credentials/vertex-ai-sa.json
AGENT_MODEL=gemini-2.0-flash
FASTAPI_SERVICE_URL=http://localhost:8000
